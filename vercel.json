{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "regions": ["fra1"],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 120,
      "includeFiles": "{server/**,web/public/data/**,web/public/photos/manifest.json}"
    }
  },
  "rewrites": [
    { "source": "/cache/street/:path*", "destination": "/api/cache/street/:path*" },
    { "source": "/((?!api/|cache/).*)", "destination": "/index.html" }
  ]
}
