{
  "name": "zouave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --experimental-strip-types server/index.ts\" \"vite --config web/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "start": "npm run build && node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test server/api.test.ts && node --experimental-strip-types --experimental-test-module-mocks --test scripts/tools.test.mjs && node --experimental-strip-types --test scripts/hero.test.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.1",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "express": "^5.1.0",
    "maplibre-gl": "^6.15.0",
    "openai": "^7.43.0",
    "pmtiles": "^4.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
